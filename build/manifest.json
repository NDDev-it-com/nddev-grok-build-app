{
  "schema_version": 3,
  "name": "nddev-grok-build-app",
  "build_version": "0.2.0",
  "entrypoint": "python3 cli-tools/nddev_grok_build.py",
  "source_root": "setups",
  "profile_root": "profiles",
  "default_setup": "nddev-builder",
  "default_profile": "full-auto",
  "setup_ids": ["nddev-builder"],
  "profile_ids": ["full-auto", "safe"],
  "legacy_setup_ids": ["safe", "balanced", "full-auto"],
  "managed_files": [
    "config.toml",
    "AGENTS.md",
    "plugins/nddev-builder/agents/nddev-builder.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/agents/nddev-builder.md",
    "agents/nddev-builder.md",
    "plugins/nddev-builder/plugin.json",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/plugin.json",
    "plugins/nddev-builder/skills/grok-agents-subagents/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-agents-subagents/SKILL.md",
    "skills/grok-agents-subagents/SKILL.md",
    "plugins/nddev-builder/skills/grok-config-profile/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-config-profile/SKILL.md",
    "skills/grok-config-profile/SKILL.md",
    "plugins/nddev-builder/skills/grok-creator-checker-release/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-creator-checker-release/SKILL.md",
    "skills/grok-creator-checker-release/SKILL.md",
    "plugins/nddev-builder/skills/grok-hooks/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-hooks/SKILL.md",
    "skills/grok-hooks/SKILL.md",
    "plugins/nddev-builder/skills/grok-install-lifecycle/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-install-lifecycle/SKILL.md",
    "skills/grok-install-lifecycle/SKILL.md",
    "plugins/nddev-builder/skills/grok-mcp/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-mcp/SKILL.md",
    "skills/grok-mcp/SKILL.md",
    "plugins/nddev-builder/skills/grok-permissions-sandbox/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-permissions-sandbox/SKILL.md",
    "skills/grok-permissions-sandbox/SKILL.md",
    "plugins/nddev-builder/skills/grok-plugins-marketplace/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-plugins-marketplace/SKILL.md",
    "skills/grok-plugins-marketplace/SKILL.md",
    "plugins/nddev-builder/skills/grok-skills-instructions/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/grok-skills-instructions/SKILL.md",
    "skills/grok-skills-instructions/SKILL.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/nddev-builder/SKILL.md",
    "plugins/nddev-builder/skills/nddev-builder/SKILL.md",
    "skills/nddev-builder/SKILL.md",
    "plugins/nddev-builder/skills/nddev-builder/references/native-surfaces.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/nddev-builder/references/native-surfaces.md",
    "skills/nddev-builder/references/native-surfaces.md",
    "plugins/nddev-builder/skills/nddev-builder/references/validation-workflows.md",
    "plugins/marketplaces/nddev-builder/plugins/nddev-builder/skills/nddev-builder/references/validation-workflows.md",
    "skills/nddev-builder/references/validation-workflows.md",
    "plugins/marketplaces/nddev-builder/.grok-plugin/marketplace.json",
    "plugins/marketplaces/nddev-builder/.grok-plugin/plugin-index.json",
    "NDDEV-GROK-BUILD-SETUP.json"
  ],
  "command_policy": {
    "json_supported": [
      "list",
      "status",
      "plan",
      "install",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli"
    ],
    "target_required": [
      "status",
      "plan",
      "install",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli",
      "launch"
    ],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>"
  },
  "runtime_launch": {
    "command": "grok",
    "direct_command": "GROK_HOME=<absolute-target> <absolute-target>/bin/grok [args...]",
    "environment_variable": "GROK_HOME",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "streams_child_stdio": true,
    "requires_clean_managed_target": true,
    "requires_current_target_owned_software": true,
    "denies_legacy_managed_state": true,
    "path_fallback": false,
    "managed_command": "bin/grok",
    "target_environment_scope": "child-process-only",
    "required_version": "0.2.112",
    "supported_platforms": ["macos", "linux"]
  },
  "software_lifecycle": {
    "supported": true,
    "product_name": "Grok Build",
    "command": "grok",
    "version": "0.2.112",
    "channel": "stable",
    "npm_package": "@xai-official/grok",
    "npm_integrity": "sha512-dCXAiFHmn3JTOK+vPfCIzzum1GmxPB81NH73yYhqleXx1y/Ks3qjwJ+GeEXmB7eudiap98j9Nj1cDwH4lSuaOw==",
    "npm_shasum": "cd103bfeb3d102dff87788a9cbe8d36c293112c8",
    "npm_tarball": "https://registry.npmjs.org/@xai-official/grok/-/grok-0.2.112.tgz",
    "installer_url": "https://x.ai/cli/install.sh",
    "installer_sha256": "0465d810453bbf18608ccae310fa79f4c59ae4a0538bd8a3a374ebce749be952",
    "installer_exact_version_arg": "0.2.112",
    "status_command": "python3 cli-tools/nddev_grok_build.py software-status --target <absolute-target> [--json]",
    "install_command": "python3 cli-tools/nddev_grok_build.py install-cli --target <absolute-target> [--json]",
    "update_command": "python3 cli-tools/nddev_grok_build.py update-cli --target <absolute-target> [--json]",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-GROK-BUILD-SOFTWARE.json, .nddev-software/grok-build, .nddev-software/grok-build/versions/0.2.112, or bin/grok",
    "install_precondition": "absent target-owned software presence",
    "update_precondition": "existing safe target-owned software presence, including missing or corrupt identity stamp repair",
    "target_owned": true,
    "software_root": ".nddev-software/grok-build/versions/0.2.112",
    "entrypoint": "bin/grok",
    "stage_env": {
      "HOME": "<stage>/home",
      "GROK_HOME": "<stage>/grok-home",
      "GROK_BIN_DIR": "<stage>/bin",
      "GROK_CHANNEL": "stable",
      "TMPDIR": "<stage>/tmp",
      "PATH": "<stage>/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"
    },
    "status_executes_binary": false,
    "version_probe": "staging binary only",
    "fetch_errors_are_domain_errors": true,
    "persisted_stage_paths": ["bin/grok", ".nddev-software/grok-build/versions/0.2.112/grok"],
    "discarded_stage_paths": ["shell rc files", "completions", "installer config.toml", "agent alias"],
    "private_modes": {
      "directories": "0700",
      "stamp": "0600",
      "binary": "0700"
    },
    "rollback_on_failure": true
  },
  "setup_profile_model": {
    "content_setup": "nddev-builder",
    "permission_profiles": {
      "full-auto": {
        "permission_mode": "always-approve",
        "sandbox_profile": "off",
        "managed_permission_rules": false
      },
      "safe": {
        "permission_mode": "ask",
        "sandbox_profile": "strict",
        "managed_permission_rules": false
      }
    }
  },
  "nddev_builder": {
    "source": "builder/nddev-builder",
    "version": "0.2.0",
    "native_surfaces": [
      "$GROK_HOME/skills/nddev-builder/SKILL.md",
      "$GROK_HOME/agents/nddev-builder.md",
      "$GROK_HOME/plugins/nddev-builder/plugin.json",
      "$GROK_HOME/plugins/marketplaces/nddev-builder/.grok-plugin/marketplace.json",
      "$GROK_HOME/plugins/marketplaces/nddev-builder/.grok-plugin/plugin-index.json",
      "$GROK_HOME/plugins/marketplaces/nddev-builder/plugins/nddev-builder/plugin.json",
      "[plugins].enabled",
      "[[marketplace.sources]]"
    ],
    "managed_capabilities": {
      "memory": true,
      "subagents": true,
      "web_fetch": true,
      "lsp_tools": true,
      "write_file": true,
      "tool_search": true,
      "auto_update": false,
      "load_envrc": false
    },
    "binary_delivery": false
  },
  "backup_policy": {
    "location": "$GROK_HOME/.nddev-grok-build/backups",
    "legacy_sibling_restore": "read only after strict owner, mode, and canonical-target validation",
    "envelope": "NDDEV-GROK-BUILD-BACKUP.json",
    "slots": 10,
    "canonical_target_bound": true,
    "strict_envelope_validation": true,
    "base64_validate": true,
    "restored_stamp_path_set_validated": true
  },
  "transaction_policy": {
    "absolute_target_required": true,
    "default_target": null,
    "managed_file_mode": "0600",
    "managed_directory_mode": "0700",
    "new_target_mode": "0700",
    "existing_target_mode_required": "0700",
    "preserve_unmanaged_files": true,
    "reject_symlink_targets": true,
    "reject_symlink_managed_files": true,
    "reject_hardlinked_managed_files": true,
    "rollback_on_failure": true,
    "lock": "$GROK_HOME/.nddev-grok-build/locks/target.lock",
    "lock_parent": "$GROK_HOME/.nddev-grok-build/locks",
    "lock_type": "persistent regular file with fcntl.flock",
    "lock_file_mode": "0600",
    "control_root_mode_while_locked": "0700",
    "lock_parent_mode_while_held": "0500",
    "lock_parent_mode_when_unlocked": "0700",
    "lock_held_through_launch_child": true,
    "lock_crash_recovery": true,
    "restore_prevalidates_backup_before_mutation": true,
    "restore_post_validates_clean_state": true,
    "restore_rollback_byte_identical_on_failure": true,
    "launch_requires_current_software": true,
    "launch_uses_verified_private_image": true,
    "launch_image_directory": "$GROK_HOME/.nddev-grok-build/launch-images",
    "launch_image_file_mode": "0500",
    "runtime_home_tmp_xdg_writable_while_locked": true,
    "same_uid_malicious_mutation_boundary": "cooperative same user manager operations are serialized; direct malicious same user mutation, especially under sandbox off, is outside the cross-user isolation boundary"
  },
  "runtime_compatibility": {
    "baseline_ref": "references/grok-build-baseline.json",
    "version_ref": "build/version.json"
  }
}
