{
  "schema_version": 2,
  "name": "nddev-grok-build-app",
  "build_version": "0.1.0",
  "entrypoint": "python3 cli-tools/nddev_grok_build.py",
  "source_root": "setups",
  "setup_ids": [
    "safe",
    "balanced",
    "full-auto"
  ],
  "managed_files": [
    "config.toml",
    "AGENTS.md",
    "skills/nddev-builder/SKILL.md",
    "agents/nddev-builder.md",
    "plugins/nddev-builder/plugin.json",
    "plugins/nddev-builder/skills/nddev-builder/SKILL.md",
    "plugins/nddev-builder/agents/nddev-builder.md",
    "NDDEV-GROK-BUILD-SETUP.json"
  ],
  "command_policy": {
    "json_supported": [
      "list",
      "status",
      "plan",
      "install",
      "switch",
      "restore",
      "remove"
    ],
    "target_required": [
      "status",
      "plan",
      "install",
      "switch",
      "restore",
      "remove",
      "launch"
    ],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>"
  },
  "runtime_launch": {
    "command": "grok",
    "direct_command": "GROK_HOME=<absolute-target> grok [args...]",
    "environment_variable": "GROK_HOME",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "streams_child_stdio": true,
    "requires_clean_managed_target": true,
    "target_environment_scope": "child-process-only",
    "required_version": "0.2.112"
  },
  "backup_policy": {
    "location": "sibling .<target-name>.nddev-grok-build-backups",
    "envelope": "NDDEV-GROK-BUILD-BACKUP.json",
    "slots": 10,
    "canonical_target_bound": true
  },
  "transaction_policy": {
    "absolute_target_required": true,
    "default_target": null,
    "managed_file_mode": "0600",
    "managed_directory_mode": "0700",
    "new_target_mode": "0700",
    "preserve_existing_target_mode": true,
    "preserve_unmanaged_files": true,
    "reject_symlink_targets": true,
    "reject_symlink_managed_files": true,
    "reject_hardlinked_managed_files": true,
    "rollback_on_failure": true,
    "lock": "exclusive sibling directory"
  },
  "nddev_builder": {
    "default_on": true,
    "source": "builder/nddev-builder",
    "native_surfaces": [
      "$GROK_HOME/skills/nddev-builder/SKILL.md",
      "$GROK_HOME/agents/nddev-builder.md",
      "$GROK_HOME/plugins/nddev-builder/plugin.json",
      "$GROK_HOME/plugins/nddev-builder/skills/nddev-builder/SKILL.md",
      "$GROK_HOME/plugins/nddev-builder/agents/nddev-builder.md",
      "[plugins].enabled"
    ],
    "external_marketplace_published": null
  },
  "runtime_compatibility": {
    "baseline_ref": "references/grok-build-baseline.json",
    "version_ref": "build/version.json"
  }
}
