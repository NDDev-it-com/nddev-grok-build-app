{
  "contract_version": 3,
  "product_name": "nddev-grok-build-app",
  "display_name": "NDDev Grok Build Setup Manager",
  "description": "Portable, explicit-target setup manager for current Grok Build configuration, native builder marketplace capability projection, isolated launch, and target-bound lifecycle backups.",
  "github_repository": "NDDev-it-com/nddev-grok-build-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_root": "setups",
  "profile_root": "profiles",
  "setup_system": {
    "catalog_root": "setups",
    "profile_root": "profiles",
    "identity_source": "<setup>/setup.json:id",
    "profile_identity_source": "<profile>/profile.json:id",
    "default_setup": "nddev-builder",
    "default_profile": "full-auto",
    "setup_ids": ["nddev-builder"],
    "profile_ids": ["full-auto", "safe"],
    "legacy_setup_ids": ["safe", "balanced", "full-auto"],
    "list_command": "python3 cli-tools/nddev_grok_build.py list [--json]",
    "status_command": "python3 cli-tools/nddev_grok_build.py status --target <absolute-dir> [--json]",
    "plan_command": "python3 cli-tools/nddev_grok_build.py plan --setup nddev-builder --profile <id> --target <absolute-dir> [--json]",
    "install_command": "python3 cli-tools/nddev_grok_build.py install --setup nddev-builder --profile <id> --target <absolute-dir> [--json]",
    "switch_command": "python3 cli-tools/nddev_grok_build.py switch --setup nddev-builder --profile <id> --target <absolute-dir> [--json]",
    "migrate_command": "python3 cli-tools/nddev_grok_build.py migrate --target <absolute-dir> [--profile <id>] [--json]",
    "restore_command": "python3 cli-tools/nddev_grok_build.py restore --backup <0..9> --target <absolute-dir> [--json]",
    "remove_command": "python3 cli-tools/nddev_grok_build.py remove --target <absolute-dir> [--json]",
    "software_status_command": "python3 cli-tools/nddev_grok_build.py software-status --target <absolute-dir> [--json]",
    "software_install_command": "python3 cli-tools/nddev_grok_build.py install-cli --target <absolute-dir> [--json]",
    "software_update_command": "python3 cli-tools/nddev_grok_build.py update-cli --target <absolute-dir> [--json]",
    "software_remove_command": "python3 cli-tools/nddev_grok_build.py remove-cli --target <absolute-dir> [--json]",
    "launch_command": "python3 cli-tools/nddev_grok_build.py launch --target <absolute-dir> -- [args...]"
  },
  "managed_state": {
    "environment_variable": "GROK_HOME",
    "default_target": null,
    "stamp_file": "NDDEV-GROK-BUILD-SETUP.json",
    "stamp_schema": 2,
    "legacy_stamp_schema": 1,
    "control_dir": ".nddev-grok-build",
    "backup_pool": ".nddev-grok-build/backups",
    "managed_file_mode": "0600",
    "managed_directory_mode": "0700",
    "existing_target_mode_required": "0700",
    "preserve_other_state": true,
    "co_owned_config_strategy": "replace-managed-marker-block-only",
    "legacy_allowed_commands": ["status", "migrate", "restore", "remove"],
    "legacy_launch_denied": true
  },
  "setup_profile_model": {
    "content_setup": {
      "id": "nddev-builder",
      "owned_config": {
        "[features].web_fetch": true,
        "[features].lsp_tools": true,
        "[features].write_file": true,
        "[features].tool_search": true,
        "[memory].enabled": true,
        "[subagents].enabled": true,
        "[cli].auto_update": false,
        "[session].load_envrc": false,
        "[plugins].enabled": ["nddev-builder"],
        "[[marketplace.sources]].name": "NDDev Builder"
      }
    },
    "permission_profiles": {
      "full-auto": {
        "permission_mode": "always-approve",
        "sandbox_profile": "off",
        "managed_permission_rules": false
      },
      "safe": {
        "permission_mode": "ask",
        "sandbox_profile": "strict",
        "managed_permission_rules": false
      }
    }
  },
  "safety": {
    "absolute_target_required": true,
    "canonical_target_binding": true,
    "relative_target_rejected": true,
    "existing_target_private_mode_required": true,
    "target_symlinks_rejected": true,
    "managed_symlinks_rejected": true,
    "managed_hardlinks_rejected": true,
    "sibling_lock_and_backup_state_ignored": true,
    "external_bootstrap_lock_persistent": true,
    "external_bootstrap_lock_not_under_target_or_parent": true,
    "external_bootstrap_lock_uses_fixed_system_temp_root": true,
    "external_bootstrap_lock_ignores_ambient_tmpdir": true,
    "external_bootstrap_lock_json_binding": true,
    "external_lock_acquired_before_target_inspection": true,
    "external_lock_released_after_internal_lock": true,
    "external_lock_not_exposed_to_child_env": true,
    "persistent_flock_lock_file": true,
    "control_root_stays_writable_while_locked": true,
    "lock_parent_non_writable_while_held": true,
    "lock_held_through_launch_child": true,
    "concurrent_setup_mutations_denied_while_launching": true,
    "legacy_sibling_backups_read_only_when_strictly_validated": true,
    "bounded_managed_reads": true,
    "max_backups": 10,
    "rollback_on_failure": true,
    "restore_validates_backup_envelope_before_mutation": true,
    "restore_validates_stamp_path_set_and_digests": true,
    "backup_entry_payload_size_sha256_validated": true,
    "backup_slot_replacement_transactional": true,
    "failed_mutation_removes_new_backup": true,
    "restore_post_validates_clean_state": true,
    "restore_rollback_byte_identical_on_failure": true,
    "same_setup_profile_noop": true,
    "postconditions_compare_intended_bytes": true,
    "atomic_write_order": "temporary write, temporary mode, file fsync, replace, parent fsync",
    "post_replace_failure_rolls_back": true,
    "software_no_target_stage_or_rollback_dirs": true,
    "installer_fetch_errors_are_domain_errors": true,
    "launch_requires_clean_managed_target": true,
    "launch_requires_current_target_owned_software": true,
    "launch_uses_verified_private_image": true,
    "launch_image_regular_immutable_mode": true,
    "runtime_home_tmp_xdg_stay_writable_while_locked": true,
    "launch_denies_lifecycle_auth_plugin_marketplace_mcp_mutations": true,
    "launch_strips_provider_credentials": true,
    "no_ambient_provider_secrets": true,
    "same_uid_malicious_mutation_boundary": "cooperative same user manager operations are serialized; direct malicious same user mutation of the target or bootstrap root, especially under sandbox off, is outside the cross-user isolation boundary"
  },
  "runtime_launch": {
    "command": "grok",
    "direct_command": "GROK_HOME=<absolute-target> <absolute-target>/bin/grok [args...]",
    "environment_variable": "GROK_HOME",
    "manager_command": "python3 cli-tools/nddev_grok_build.py launch --target <absolute-target> -- [args...]",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "streams_child_stdio": true,
    "target_environment_scope": "child-process-only",
    "required_version": "0.2.112",
    "managed_command": "bin/grok",
    "requires_current_target_owned_software": true,
    "path_fallback": false,
    "json_manager_errors_supported": true,
    "supported_platforms": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "unsupported_platforms": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "supported_architectures": {
      "macos": ["arm64", "x64"],
      "ubuntu-glibc": ["arm64", "x64"]
    },
    "platform_detection": {
      "canonical_host_ids": [
        "macos-arm64",
        "macos-x64",
        "ubuntu-glibc-arm64",
        "ubuntu-glibc-x64"
      ],
      "macos_system": "Darwin",
      "ubuntu_system": "Linux",
      "ubuntu_os_release_id": "ubuntu",
      "ubuntu_libc": "glibc",
      "ubuntu_version_floor": null,
      "glibc_version_floor": null,
      "ubuntu_scope": "NDDev product scope only; upstream publishes Linux assets but no Ubuntu version or glibc floor",
      "linux_distro_sources": ["/etc/os-release", "/usr/lib/os-release"],
      "standard_unsupported_categories": [
        "windows",
        "non-ubuntu-linux",
        "linux-musl",
        "unsupported-architecture"
      ],
      "non_ubuntu_rejection": "before installer fetch, installer staging, or launch child execution"
    },
    "vendor_platform_observations": {
      "official_installer_assets": {
        "macos": ["grok-0.2.112-macos-x86_64", "grok-0.2.112-macos-aarch64"],
        "linux": ["grok-0.2.112-linux-x86_64", "grok-0.2.112-linux-aarch64"]
      },
      "installer_asset_mapping": {
        "macos-arm64": "grok-0.2.112-macos-aarch64",
        "macos-x64": "grok-0.2.112-macos-x86_64",
        "ubuntu-glibc-arm64": "grok-0.2.112-linux-aarch64",
        "ubuntu-glibc-x64": "grok-0.2.112-linux-x86_64"
      },
      "npm_package": "@xai-official/grok",
      "npm_platform_package_ids_observed_not_module_install": [
        "@xai-official/grok-darwin-x64",
        "@xai-official/grok-darwin-arm64",
        "@xai-official/grok-linux-x64",
        "@xai-official/grok-linux-arm64"
      ],
      "npm_package_distinction": "Installer asset names are not derived from npm @xai-official/grok-{darwin,linux}-{x64,arm64} package names",
      "musl_baseline_variant": null,
      "baseline_variant": null,
      "upstream_ubuntu_version_floor": null,
      "upstream_glibc_floor": null
    }
  },
  "software_lifecycle": {
    "stamp_file": "NDDEV-GROK-BUILD-SOFTWARE.json",
    "stamp_schema": 2,
    "status_command": "python3 cli-tools/nddev_grok_build.py software-status --target /absolute/target --json",
    "install_command": "python3 cli-tools/nddev_grok_build.py install-cli --target /absolute/target --json",
    "update_command": "python3 cli-tools/nddev_grok_build.py update-cli --target /absolute/target --json",
    "remove_command": "python3 cli-tools/nddev_grok_build.py remove-cli --target /absolute/target --json",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-GROK-BUILD-SOFTWARE.json, .nddev-software/grok-build, .nddev-software/grok-build/versions/0.2.112, or bin/grok",
    "install_precondition": "install-cli refuses any existing target-owned software presence; use update-cli for partial or existing state",
    "update_precondition": "update-cli repairs existing safe target-owned software presence and refuses absent software state",
    "remove_precondition": "remove-cli removes absent, partial, or complete safe target-owned software state without removing setup/auth/unrelated target state",
    "official_installer": "https://x.ai/cli/install.sh",
    "installer_sha256": "0465d810453bbf18608ccae310fa79f4c59ae4a0538bd8a3a374ebce749be952",
    "installer_exact_version_arg": "0.2.112",
    "channel": "stable",
    "npm_package": "@xai-official/grok",
    "npm_integrity": "sha512-dCXAiFHmn3JTOK+vPfCIzzum1GmxPB81NH73yYhqleXx1y/Ks3qjwJ+GeEXmB7eudiap98j9Nj1cDwH4lSuaOw==",
    "npm_shasum": "cd103bfeb3d102dff87788a9cbe8d36c293112c8",
    "npm_tarball": "https://registry.npmjs.org/@xai-official/grok/-/grok-0.2.112.tgz",
    "version": "0.2.112",
    "command": "grok",
    "target_owned": true,
    "software_root": ".nddev-software/grok-build/versions/0.2.112",
    "entrypoint": "bin/grok",
    "status_executes_binary": false,
    "version_probe": "staging binary only",
    "fetch_errors_are_domain_errors": true,
    "stage_env": {
      "HOME": "<stage>/home",
      "GROK_HOME": "<stage>/grok-home",
      "GROK_BIN_DIR": "<stage>/bin",
      "GROK_CHANNEL": "stable",
      "TMPDIR": "<stage>/tmp",
      "PATH": "<stage>/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"
    },
    "persisted_stage_paths": ["bin/grok", ".nddev-software/grok-build/versions/0.2.112/grok"],
    "discarded_stage_paths": ["shell rc files", "completions", "installer config.toml", "agent alias"],
    "private_modes": {
      "directories": "0700",
      "stamp": "0600",
      "binary": "0700"
    },
    "rollback_on_failure": true,
    "credential_inheritance": "provider secrets are not inherited by installer subprocesses or launch"
  },
  "plugin_marketplace": {
    "plugin_id": "nddev-builder",
    "plugin_manifest": "builder/nddev-builder/plugins/nddev-builder/plugin.json",
    "marketplace_manifest": "builder/nddev-builder/.grok-plugin/marketplace.json",
    "marketplace_index": "builder/nddev-builder/.grok-plugin/plugin-index.json",
    "builder_enabled_in_base_config": true,
    "default_on_in_content_setup": true,
    "native_projection": {
      "user_skill": "$GROK_HOME/skills/nddev-builder/SKILL.md",
      "user_agent": "$GROK_HOME/agents/nddev-builder.md",
      "trusted_user_plugin": "$GROK_HOME/plugins/nddev-builder",
      "local_marketplace": "$GROK_HOME/plugins/marketplaces/nddev-builder",
      "plugin_skill": "$GROK_HOME/plugins/nddev-builder/skills/nddev-builder/SKILL.md",
      "plugin_agent": "$GROK_HOME/plugins/nddev-builder/agents/nddev-builder.md",
      "config_enablement": "[plugins].enabled = [\"nddev-builder\"]",
      "marketplace_enablement": "[[marketplace.sources]]"
    },
    "external_marketplace_published": null,
    "binary_delivery": false
  },
  "runtime_compatibility": {
    "baseline_ref": "references/grok-build-baseline.json",
    "version_ref": "build/version.json",
    "official_docs": {
      "overview": "https://docs.x.ai/build/getting-started",
      "cli": "https://docs.x.ai/build/cli/reference",
      "settings": "https://docs.x.ai/build/settings",
      "settings_reference": "https://docs.x.ai/build/settings/reference",
      "permissions": "https://docs.x.ai/build/features/permissions",
      "sandbox": "https://docs.x.ai/build/features/sandbox",
      "skills_plugins_marketplaces": "https://docs.x.ai/build/features/skills-plugins-marketplaces",
      "mcp_servers": "https://docs.x.ai/build/features/mcp-servers",
      "hooks": "https://docs.x.ai/build/features/hooks",
      "subagents": "https://docs.x.ai/build/features/subagents",
      "project_rules": "https://docs.x.ai/build/features/project-rules",
      "enterprise": "https://docs.x.ai/build/enterprise",
      "source": "https://github.com/xai-org/grok-build"
    }
  }
}
