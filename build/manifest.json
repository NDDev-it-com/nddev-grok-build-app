      "linux_distro_sources": ["/etc/os-release", "/usr/lib/os-release"],
      "standard_unsupported_categories": [
        "windows",
        "non-ubuntu-linux",
        "linux-musl",
        "unsupported-architecture"
      ],
      "non_ubuntu_rejection": "before target resolution, target inspection, target creation, bootstrap lock, target lock, installer fetch, installer staging, or launch child execution"
    },
    "vendor_platform_observations": {
      "official_installer_assets": {
        "macos": ["grok-0.2.112-macos-x86_64", "grok-0.2.112-macos-aarch64"],
        "linux": ["grok-0.2.112-linux-x86_64", "grok-0.2.112-linux-aarch64"],
        "windows": ["grok-0.2.112-windows-x86_64.exe", "grok-0.2.112-windows-aarch64.exe"]
      },
      "installer_asset_mapping": {
        "macos-arm64": "grok-0.2.112-macos-aarch64",
        "macos-x64": "grok-0.2.112-macos-x86_64",
        "ubuntu-glibc-arm64": "grok-0.2.112-linux-aarch64",
        "ubuntu-glibc-x64": "grok-0.2.112-linux-x86_64"
      },
      "npm_package": "@xai-official/grok",
      "npm_platform_package_ids_observed_not_module_install": [
        "@xai-official/grok-darwin-x64",
        "@xai-official/grok-darwin-arm64",
        "@xai-official/grok-linux-x64",
        "@xai-official/grok-linux-arm64",
        "@xai-official/grok-win32-x64",
        "@xai-official/grok-win32-arm64"
      ],
      "product_unsupported_vendor_observations": {
        "windows": {
          "product_supported": false,
          "official_installer_assets": ["grok-0.2.112-windows-x86_64.exe", "grok-0.2.112-windows-aarch64.exe"],
          "npm_optional_packages": ["@xai-official/grok-win32-x64", "@xai-official/grok-win32-arm64"]
        }
      },
      "npm_package_distinction": "Installer asset names are not derived from npm @xai-official/grok-{darwin,linux,win32}-{x64,arm64} package names",
      "musl_baseline_variant": null,
      "baseline_variant": null,
      "upstream_ubuntu_version_floor": null,
      "upstream_glibc_floor": null
    }
  },
  "software_lifecycle": {
    "supported": true,
    "product_name": "Grok Build",
    "command": "grok",
    "version": "0.2.112",
    "channel": "stable",
    "npm_package": "@xai-official/grok",
    "npm_integrity": "sha512-dCXAiFHmn3JTOK+vPfCIzzum1GmxPB81NH73yYhqleXx1y/Ks3qjwJ+GeEXmB7eudiap98j9Nj1cDwH4lSuaOw==",
    "npm_shasum": "cd103bfeb3d102dff87788a9cbe8d36c293112c8",
    "npm_tarball": "https://registry.npmjs.org/@xai-official/grok/-/grok-0.2.112.tgz",
    "installer_url": "https://x.ai/cli/install.sh",
    "installer_sha256": "0465d810453bbf18608ccae310fa79f4c59ae4a0538bd8a3a374ebce749be952",
    "installer_exact_version_arg": "0.2.112",
    "status_command": "python3 cli-tools/nddev_grok_build.py software-status --target <absolute-target> [--json]",
    "install_command": "python3 cli-tools/nddev_grok_build.py install-cli --target <absolute-target> [--json]",
    "update_command": "python3 cli-tools/nddev_grok_build.py update-cli --target <absolute-target> [--json]",
    "remove_command": "python3 cli-tools/nddev_grok_build.py remove-cli --target <absolute-target> [--json]",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-GROK-BUILD-SOFTWARE.json, .nddev-software/grok-build, .nddev-software/grok-build/versions/0.2.112, or bin/grok",
    "install_precondition": "absent target-owned software presence",
    "update_precondition": "existing safe target-owned software presence, including missing or corrupt identity stamp repair",
    "remove_precondition": "absent, partial, or complete safe target-owned software presence",
    "target_owned": true,
    "software_root": ".nddev-software/grok-build/versions/0.2.112",
    "entrypoint": "bin/grok",
    "stage_env": {
      "HOME": "<stage>/home",
      "GROK_HOME": "<stage>/grok-home",
      "GROK_BIN_DIR": "<stage>/bin",
      "GROK_CHANNEL": "stable",
      "TMPDIR": "<stage>/tmp",
      "PATH": "<stage>/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"
    },
    "status_executes_binary": false,
    "version_probe": "staging binary only",
    "fetch_errors_are_domain_errors": true,
    "persisted_stage_paths": ["bin/grok", ".nddev-software/grok-build/versions/0.2.112/grok"],
    "discarded_stage_paths": ["shell rc files", "completions", "installer config.toml", "agent alias"],
    "private_modes": {
      "directories": "0700",
      "stamp": "0600",
      "binary": "0700"
    },
    "rollback_on_failure": true
  },
  "setup_profile_model": {
    "content_setup": "nddev-builder",
    "permission_profiles": {
      "full-auto": {
        "permission_mode": "always-approve",
        "sandbox_profile": "off",
        "managed_permission_rules": false
      },
      "safe": {
        "permission_mode": "ask",
        "sandbox_profile": "strict",
        "managed_permission_rules": false
      }
    }
  },
  "nddev_builder": {
    "source": "builder/nddev-builder",
    "version": "0.2.0",
    "native_surfaces": [
      "$GROK_HOME/skills/nddev-builder/SKILL.md",
      "$GROK_HOME/agents/nddev-builder.md",
      "$GROK_HOME/plugins/nddev-builder/plugin.json",
      "$GROK_HOME/plugins/marketplaces/nddev-builder/.grok-plugin/marketplace.json",
      "$GROK_HOME/plugins/marketplaces/nddev-builder/.grok-plugin/plugin-index.json",
      "$GROK_HOME/plugins/marketplaces/nddev-builder/plugins/nddev-builder/plugin.json",
      "[plugins].enabled",
      "[[marketplace.sources]]"
    ],
    "managed_capabilities": {
      "memory": true,
      "subagents": true,
      "web_fetch": true,
      "lsp_tools": true,
      "write_file": true,
      "tool_search": true,
      "auto_update": false,
      "load_envrc": false
    },
    "binary_delivery": false
  },
  "backup_policy": {
    "location": "$GROK_HOME/.nddev-grok-build/backups",
    "legacy_sibling_restore": "read only after strict owner, mode, and canonical-target validation",
    "envelope": "NDDEV-GROK-BUILD-BACKUP.json",
    "slots": 10,
    "canonical_target_bound": true,
    "strict_envelope_validation": true,
    "base64_validate": true,
    "entry_payload_size_sha256_validated": true,
    "restored_stamp_path_set_validated": true,
    "transactional_slot_replacement": true,
    "failed_mutation_removes_new_backup": true
  },
  "transaction_policy": {
    "absolute_target_required": true,
    "default_target": null,
    "managed_file_mode": "0600",
    "managed_directory_mode": "0700",
    "new_target_mode": "0700",
    "existing_target_mode_required": "0700",
    "preserve_unmanaged_files": true,
    "reject_symlink_targets": true,
    "reject_symlink_managed_files": true,
    "reject_hardlinked_managed_files": true,
    "rollback_on_failure": true,
    "object_preserving_rollback": true,
    "atomic_write_order": "temporary write, temporary mode, file fsync, replace, parent fsync",
    "post_replace_failure_rolls_back": true,
    "same_setup_profile_noop": true,
    "postconditions_compare_intended_bytes": true,
    "software_no_target_stage_or_rollback_dirs": true,
    "supported_host_preflight_before_target_resolution": true,
    "external_bootstrap_lock": "fixed resolved system temp root/.nddev-grok-build-app.uid-<uid>/<sha256(namespace+canonical-target)>",
    "external_bootstrap_lock_system_root": "resolved /tmp; /private/tmp on macOS, /tmp on Ubuntu",
    "external_bootstrap_lock_product_root_mode": "0700",
    "external_bootstrap_lock_file_mode": "0600",
    "external_bootstrap_lock_persistent": true,
    "external_bootstrap_lock_unlinked_on_release": false,
    "external_bootstrap_lock_binding": "JSON schema_version/product_name/namespace/canonical_target/lock_id after LOCK_EX",
    "external_bootstrap_lock_target_identity": "resolved real parent plus literal target basename",
    "external_bootstrap_lock_from_ambient_tmpdir": false,
    "external_bootstrap_lock_child_env": false,
    "external_lock_acquired_before_target_inspection": true,
    "lock": "$GROK_HOME/.nddev-grok-build/locks/target.lock",
    "lock_parent": "$GROK_HOME/.nddev-grok-build/locks",
    "lock_type": "persistent regular file with fcntl.flock",
    "lock_file_mode": "0600",
    "control_root_mode_while_locked": "0700",
    "lock_parent_mode_while_held": "0500",
    "lock_parent_mode_when_unlocked": "0700",
    "lock_held_through_launch_child": true,
    "lock_crash_recovery": true,
    "lock_order": "external bootstrap lock first, target-internal lock second; release target-internal first, external last",
    "restore_prevalidates_backup_before_mutation": true,
    "restore_post_validates_clean_state": true,
    "restore_rollback_byte_identical_on_failure": true,
    "launch_requires_current_software": true,
    "launch_uses_verified_private_image": true,
    "launch_image_directory": "$GROK_HOME/.nddev-grok-build/launch-images",
    "launch_image_file_mode": "0500",
    "runtime_home_tmp_xdg_writable_while_locked": true,
    "same_uid_malicious_mutation_boundary": "cooperative same user manager operations are serialized; direct malicious same user mutation of the target or bootstrap root, especially under sandbox off, is outside the cross-user isolation boundary"
  },
  "runtime_compatibility": {
    "baseline_ref": "references/grok-build-baseline.json",
    "version_ref": "build/version.json"
  }
}
