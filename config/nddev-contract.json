{
  "contract_version": 3,
  "product_name": "nddev-grok-build-app",
  "display_name": "NDDev Grok Build Setup Manager",
  "description": "Portable, explicit-target setup manager for current Grok Build configuration, native builder marketplace capability projection, isolated launch, and target-bound lifecycle backups.",
  "github_repository": "NDDev-it-com/nddev-grok-build-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_root": "setups",
  "profile_root": "profiles",
  "setup_system": {
    "catalog_root": "setups",
    "profile_root": "profiles",
    "identity_source": "<setup>/setup.json:id",
    "profile_identity_source": "<profile>/profile.json:id",
    "default_setup": "nddev-builder",
    "default_profile": "full-auto",
    "setup_ids": [
      "nddev-builder"
    ],
    "profile_ids": [
      "full-auto",
      "safe"
    ],
    "legacy_setup_ids": [
      "safe",
      "balanced",
      "full-auto"
    ],
    "list_command": "python3 cli-tools/nddev_grok_build.py list [--json]",
    "status_command": "python3 cli-tools/nddev_grok_build.py status --target <absolute-dir> [--json]",
    "plan_command": "python3 cli-tools/nddev_grok_build.py plan --setup nddev-builder --profile <id> --target <absolute-dir> [--json]",
    "install_command": "python3 cli-tools/nddev_grok_build.py install --setup nddev-builder --profile <id> --target <absolute-dir> [--json]",
    "switch_command": "python3 cli-tools/nddev_grok_build.py switch --setup nddev-builder --profile <id> --target <absolute-dir> [--json]",
    "update_command": "python3 cli-tools/nddev_grok_build.py update --target <absolute-dir> [--json]",
    "migrate_command": "python3 cli-tools/nddev_grok_build.py migrate --target <absolute-dir> [--profile <id>] [--json]",
    "restore_command": "python3 cli-tools/nddev_grok_build.py restore --backup <0..9> --target <absolute-dir> [--json]",
    "remove_command": "python3 cli-tools/nddev_grok_build.py remove --target <absolute-dir> [--json]",
    "software_status_command": "python3 cli-tools/nddev_grok_build.py software-status --target <absolute-dir> [--json]",
    "software_install_command": "python3 cli-tools/nddev_grok_build.py install-cli --target <absolute-dir> [--json]",
    "software_update_command": "python3 cli-tools/nddev_grok_build.py update-cli --target <absolute-dir> [--json]",
    "software_remove_command": "python3 cli-tools/nddev_grok_build.py remove-cli --target <absolute-dir> [--json]",
    "launch_command": "python3 cli-tools/nddev_grok_build.py launch --target <absolute-dir> -- [args...]"
  },
  "managed_state": {
    "environment_variable": "GROK_HOME",
    "default_target": null,
    "stamp_file": "NDDEV-GROK-BUILD-SETUP.json",
    "stamp_schema": 2,
    "legacy_stamp_schema": 1,
    "control_dir": ".nddev-grok-build",
    "backup_pool": ".nddev-grok-build/backups",
    "managed_file_mode": "0600",
    "managed_directory_mode": "0700",
    "existing_target_mode_required": "0700",
    "preserve_other_state": true,
    "co_owned_config_strategy": "replace-managed-marker-block-only",
    "legacy_allowed_commands": [
      "status",
      "migrate",
      "restore",
      "remove"
    ],
    "legacy_launch_denied": true
  },
  "setup_profile_model": {
    "content_setup": {
      "id": "nddev-builder",
      "owned_config": {
        "[features].web_fetch": true,
        "[features].lsp_tools": true,
        "[features].write_file": true,
        "[features].tool_search": true,
        "[memory].enabled": true,
        "[subagents].enabled": true,
        "[cli].auto_update": false,
        "[session].load_envrc": false,
        "[plugins].enabled": [
          "nddev-builder"
        ],
        "[[marketplace.sources]].name": "NDDev Builder"
      }
    },
    "permission_profiles": {
      "full-auto": {
        "permission_mode": "always-approve",
        "sandbox_profile": "off",
        "managed_permission_rules": false
      },
      "safe": {
        "permission_mode": "ask",
        "sandbox_profile": "strict",
        "managed_permission_rules": false
      }
    }
  },
  "safety": {
    "absolute_target_required": true,
    "canonical_target_binding": true,
    "relative_target_rejected": true,
    "existing_target_private_mode_required": true,
    "target_symlinks_rejected": true,
    "managed_symlinks_rejected": true,
    "managed_hardlinks_rejected": true,
    "sibling_lock_and_backup_state_ignored": true,
    "external_bootstrap_lock_persistent": true,
    "external_bootstrap_lock_not_under_target_or_parent": true,
    "external_bootstrap_lock_uses_fixed_system_temp_root": true,
    "external_bootstrap_lock_ignores_ambient_tmpdir": true,
    "external_bootstrap_lock_json_binding": true,
    "external_bootstrap_product_anchor": "global.lock",
    "external_bootstrap_target_anchor_root": "target-locks",
    "external_anchor_final_path_commit_point": true,
    "external_anchor_no_replace_publication": true,
    "external_anchor_hardlink_alias_recovery": true,
    "external_anchor_final_unlinked_on_recovery": false,
    "external_read_only_cold_no_anchor_creates_lock": false,
    "external_read_only_cold_namespace_empty_required": true,
    "external_read_only_cold_namespace_entries_fail_closed": true,
    "external_read_only_cold_namespace_identity_retry": true,
    "external_read_only_cold_no_anchor_post_observation_retry": true,
    "external_read_only_seeded_uses_product_coordination": true,
    "external_lock_acquired_before_target_inspection": true,
    "external_product_handoff_to_target_anchor": true,
    "external_lock_not_exposed_to_child_env": true,
    "persistent_external_flock_anchors": true,
    "control_root_stays_writable_while_locked": true,
    "target_local_lock_created": false,
    "target_anchor_lock_held_through_launch_child": true,
    "same_canonical_target_serialized": true,
    "different_canonical_targets_concurrent_after_handoff": true,
    "concurrent_setup_mutations_denied_while_launching": true,
    "legacy_sibling_backups_read_only_when_strictly_validated": true,
    "bounded_managed_reads": true,
    "max_backups": 10,
    "rollback_on_failure": true,
    "restore_validates_backup_envelope_before_mutation": true,
    "restore_validates_stamp_path_set_and_digests": true,
    "backup_entry_payload_size_sha256_validated": true,
    "backup_slot_replacement_transactional": true,
    "failed_mutation_removes_new_backup": true,
    "restore_post_validates_clean_state": true,
    "restore_rollback_byte_identical_on_failure": true,
    "same_setup_profile_noop": true,
    "setup_update_uses_installed_identity": true,
    "postconditions_compare_intended_bytes": true,
    "atomic_write_order": "temporary write, temporary mode, file fsync, replace, parent fsync",
    "post_replace_failure_rolls_back": true,
    "object_preserving_rollback": true,
    "software_no_target_stage_or_rollback_dirs": true,
    "cleanup_journal_immutable_pending": true,
    "cleanup_journal_top_level_pending": true,
    "cleanup_journal_mutation_only_recovery": true,
    "cleanup_journal_read_only_recovery": false,
    "cleanup_journal_serialized_max_bytes": 33554432,
    "cleanup_pending_status_plan_software_status_metadata": true,
    "cleanup_pending_drain_is_lifecycle_work": true,
    "supported_host_preflight_before_target_resolution": true,
    "installer_fetch_errors_are_domain_errors": true,
    "launch_requires_clean_managed_target": true,
    "launch_requires_current_target_owned_software": true,
    "launch_uses_verified_private_image": true,
    "launch_image_regular_immutable_mode": true,
    "runtime_home_tmp_xdg_stay_writable_while_locked": true,
    "launch_denies_lifecycle_auth_plugin_marketplace_mcp_mutations": true,
    "launch_strips_provider_credentials": true,
    "no_ambient_provider_secrets": true,
    "same_uid_malicious_mutation_boundary": "cooperative same user manager operations are serialized; direct malicious same user mutation of the target or bootstrap root, especially under sandbox off, is outside the cross-user isolation boundary",
    "verified_official_npm_artifacts_before_install": true,
    "package_scripts_disabled_for_software_install": true,
    "node_runtime_resolved_without_path_lookup": true
  },
  "runtime_launch": {
    "command": "grok",
    "direct_command": "GROK_HOME=<absolute-target> <absolute-target>/bin/grok [args...]",
    "environment_variable": "GROK_HOME",
    "manager_command": "python3 cli-tools/nddev_grok_build.py launch --target <absolute-target> -- [args...]",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "streams_child_stdio": true,
    "target_environment_scope": "child-process-only",
    "required_version": "0.2.114",
