    "unsupported_platforms": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "supported_architectures": {
      "macos": ["arm64", "x64"],
      "ubuntu-glibc": ["arm64", "x64"]
