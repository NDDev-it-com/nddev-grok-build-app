{
  "schema_version": 1,
  "id": "safe",
  "display_name": "Safe",
  "description": "Prompted permissions with the strict Grok Build sandbox and explicit deny rules for destructive or credential-oriented actions.",
  "permission_mode": "ask",
  "sandbox_profile": "strict",
  "web_fetch": false,
  "write_file": true,
  "lsp_tools": false,
  "subagents_enabled": true,
  "tool_search": true,
  "permission_deny": [
    "Bash(rm -rf *)",
    "Bash(git push *)",
    "Bash(gh release *)",
    "Read(**/.env)",
    "Read(**/*.pem)",
    "Read(**/id_rsa)",
    "Read(**/id_ed25519)"
  ],
  "permission_ask": [
    "Bash(*)",
    "Edit(**/*)"
  ],
  "nddev_builder_default": true
}
